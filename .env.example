# Optional desktop semantic classification.
# Unset SEMANTIC_PROVIDER: Claude when ANTHROPIC_API_KEY is set, otherwise Groq, otherwise deterministic only.
# Set SEMANTIC_PROVIDER=claude, groq or none to choose explicitly.
SEMANTIC_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
