{
  "name": "concentr8",
  "productName": "Concentr8",
  "version": "1.0.2",
  "private": true,
  "description": "Helps Berkeley students with ADHD start their tasks: Canvas sync, a morning phone call, and distraction blocking on the Mac.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsc || echo 'TypeScript reported errors above; starting anyway'; electron .",
    "test": "tsc && node --test dist/test/*.test.js",
    "dist": "tsc && electron-builder --mac --publish never",
    "dist:win": "tsc && electron-builder --win --publish never",
    "dist:linux": "tsc && electron-builder --linux --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "build": {
    "appId": "app.concentr8.mac",
    "productName": "Concentr8",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/services/**/*",
      "dist/shared/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon.png"
    },
    "artifactName": "Concentr8-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^37.0.0",
    "typescript": "^6.0.0",
    "electron-builder": "^26.0.0"
  }
}
